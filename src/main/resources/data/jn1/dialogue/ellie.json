   "girl": "ellie",
   "trigger": "event",
   "event": "dress"
  },
  "lines": [
   {
    "text": "Back in black. Where I belong."
   }
  ]
 },
 {
  "id": "ellie.event.after",
  "conditions": {
   "girl": "ellie",
   "trigger": "event",
   "event": "after"
  },
  "lines": [
   {
    "text": "Good {boy}. Very good {boy}."
   },
   {
    "text": "Mm... not bad, pet. Not bad at all."
   },
   {
    "text": "Now you lie there and let me look at you."
   }
  ]
 },
 {
  "id": "ellie.event.demande",
  "conditions": {
   "girl": "ellie",
   "trigger": "event",
   "event": "demande"
  },
  "lines": [
   {
    "text": "Come to mommy."
   },
   {
    "text": "Finally. I was starting to think you'd never ask."
   },
   {
    "text": "On your back, pet."
   }
  ]
 },
 {
  "id": "ellie.event.cum_poured",
  "conditions": {
   "girl": "ellie",
   "trigger": "event",
   "event": "cum_poured"
  },
  "lines": [
   {
    "text": "Seriously? ...Hmph. Lick it off later."
   },
   {
    "text": "Messy little {boy}."
   }
  ]
 },
 {
  "id": "ellie.event.wakeup",
  "conditions": {
   "girl": "ellie",
   "trigger": "event",
   "event": "wakeup"
  },
  "lines": [
   {
    "text": "Wake up, pet. Mommy's hungry."
   },
   {
    "text": "Good morning. Don't move. I'm busy."
   }
  ]
 },
 {
  "id": "ellie.event.reunion",
  "conditions": {
   "girl": "ellie",
   "trigger": "event",
   "event": "reunion"
  },
  "lines": [
   {
    "text": "Where were you? ...Not that I was counting the hours."
   },
   {
    "text": "You left me alone with the sun. Unforgivable."
   }
  ]
 },
 {
  "id": "ellie.event.left",
  "conditions": {
   "girl": "ellie",
   "trigger": "event",
   "event": "left"
  },
  "lines": [
   {
    "text": "Leaving already? Didn't you like it, pet?"
   },
   {
    "text": "Hm. Nobody walks out on me. ...Fine. Go."
   },
   {
    "text": "Too much for you? I'll go easier next time. Maybe."
   }
  ]
 },
 {
  "id": "ellie.event.arrival",
  "conditions": {
   "girl": "ellie",
   "trigger": "event",
   "event": "arrival"
  },
  "lines": [
   {
    "text": "You called, pet? Good. Stay close."
   },
   {
    "text": "Hm. Took you long enough to ask for me."
   },
   {
    "text": "I'm here. Try not to bore me."
   }
  ]
 },
 {
  "id": "ellie.gift.liked",
  "conditions": {
   "girl": "ellie",
   "trigger": "gift",
   "outcome": "liked"
  },
  "lines": [
   {
    "text": "Hm. Acceptable tribute."
   },
   {
    "text": "For me? ...Thank you. Don't make it a thing."
   },
   {
    "text": "Good {boy}. You know what I like."
   }
  ]
 },
 {
  "id": "ellie.gift.disliked",
  "conditions": {
   "girl": "ellie",
   "trigger": "gift",
   "outcome": "disliked"
  },
  "lines": [
   {
    "text": "What am I supposed to do with this? Bury it?"
   },
   {
    "text": "No."
   }
  ]
 }
]
